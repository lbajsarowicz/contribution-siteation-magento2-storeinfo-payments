{
  "name": "siteation/magento2-storeinfo-payments",
  "version": "2.2.0",
  "license": "MIT",
  "type": "magento2-module",
  "description": "The Siteation StoreInfo Payments module simplifies the process of displaying your configured payment methods on your store",
  "readme": "README.md",
  "keywords": [
    "magento2",
    "magento2-module",
    "hyva",
    "hyva-module",
    "hyva-cms",
    "payments"
  ],
  "authors": [
    {
      "name": "Siteation",
      "email": "info@siteation.dev",
      "homepage": "https://siteation.dev/"
    }
  ],
  "require": {
    "magento/framework": ">=102.0.0",
    "magento/module-payment": "^100.0",
    "siteation/magento2-icons-payment": ">=1.0.0"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Siteation\\StoreInfoPayments\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
